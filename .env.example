# JM-Website 环境变量配置
# 复制此文件为 .env 并填入实际值: cp .env.example .env

# ==================== Django 基础配置 ====================

# 允许访问的主机名/IP（逗号分隔不需要，这里只填一个主域名）
ALLOWED_HOST=your-domain.com

# Django 配置模块（一般不需要修改）
DJANGO_SETTINGS_MODULE=JmWebProject.settings

# Django Secret Key（用于 session 签名、CSRF 保护等）
# 生产环境请使用强随机字符串，可通过以下命令生成:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here

# 注册密钥（用户注册时需要输入此密钥，防止陌生人注册）
REGISTRATION_SECRET_KEY=your-registration-secret

# ==================== 安全配置 ====================

# CSRF 信任的来源（逗号分隔）
CSRF_TRUSTED_ORIGINS=http://your-domain.com,https://your-domain.com,http://127.0.0.1:8000

# CORS 允许的来源（逗号分隔）
CORS_ALLOWED_ORIGINS=https://your-domain.com,http://127.0.0.1

# ==================== Redis / Celery 配置 ====================
# 以下配置在 docker-compose.yml 中通过 environment 覆盖，
# 使用 Docker 部署时无需修改，仅本地开发时需要

# Redis 连接地址
# REDIS_URL=redis://localhost:6379/0

# Celery Broker
# CELERY_BROKER_URL=redis://localhost:6379/0

# Celery 结果后端
# CELERY_RESULT_BACKEND=redis://localhost:6379/1
