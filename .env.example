# JM-Website 环境变量配置
# 复制此文件为 .env 并填入实际值: cp .env.example .env

# ==================== Django 基础配置 ====================

# 允许访问的主机名/IP（Docker 内自动追加 127.0.0.1/localhost/web）
ALLOWED_HOST=your-domain.com

# 调试模式（本地开发设为 true，生产环境保持 false 或不设置）
DJANGO_DEBUG=false

# Django 配置模块（一般不需要修改）
DJANGO_SETTINGS_MODULE=JmWebProject.settings

# Django Secret Key（用于 session 签名、CSRF 保护等）
# 生产环境请使用强随机字符串，可通过以下命令生成:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here

# 注册密钥（用户注册时需要输入此密钥，防止陌生人注册）
REGISTRATION_SECRET_KEY=your-registration-secret

# ==================== 安全配置 ====================

# CSRF 信任的来源（逗号分隔）
CSRF_TRUSTED_ORIGINS=http://your-domain.com,https://your-domain.com,http://127.0.0.1:8000

# CORS 允许的来源（逗号分隔）
CORS_ALLOWED_ORIGINS=https://your-domain.com,http://127.0.0.1

# ==================== 服务连接 ====================

# Redis 连接地址（缓存 + Session）
REDIS_URL=redis://localhost:6379/0

# Rust 下载服务地址（Docker 内为 http://rust_downloader:3080）
RUST_DOWNLOADER_URL=http://127.0.0.1:3080

# Rust 下载完成后的回调地址（Docker 内为 http://web:8000）
CRAWL_CALLBACK_URL=http://127.0.0.1:8000

# ==================== 下载配置 ====================

# 提交给 Rust 的单章节图片并发数
JM_DOWNLOAD_IMAGE_CONCURRENCY=30

# 同时下载的章节数
JM_DOWNLOAD_PHOTO_CONCURRENCY=3

# Django→Rust HTTP 请求超时（秒）
RUST_REQUEST_TIMEOUT=15

# Django→Rust HTTP 连接池
RUST_HTTP_MAX_CONNECTIONS=10
RUST_HTTP_MAX_KEEPALIVE=5

# 下载任务状态缓存过期（秒，默认 24h）
CRAWL_STATE_TTL=86400

# jmcomic 客户端配置
JM_OPTION_TIMEOUT=30
JM_OPTION_RETRY_TIMES=5
# JM_OPTION_DOMAINS=www.cdnhjk.net,www.cdngwc.cc

# 代理地址（jmcomic 与 Rust 下载服务共用，留空/不设置则不使用代理）
# PROXY=http://127.0.0.1:10808

# ==================== 分页与缓存 ====================

# 阅读器章内分页大小（图片数/页）
IMAGES_PER_PAGE=300

# DRF 列表分页大小（藏书阁/本地库）
LIST_PAGE_SIZE=30

# 缓存 TTL（秒）
SEARCH_CACHE_TTL=120
DETAIL_CACHE_TTL=120
COMMENT_CACHE_TTL=60
CACHE_DEFAULT_TIMEOUT=300

# 匿名接口限流
ANON_THROTTLE_RATE=30/min

# ==================== 媒体与数据库 ====================

# 媒体文件根目录（默认 <项目>/JmWebProject/media）
# MEDIA_ROOT=/app/JmWebProject/media

# SQLite 路径与连接参数
# DB_NAME=/app/JmWebProject/db/db.sqlite3
# DB_TIMEOUT=5
# DB_CONN_MAX_AGE=60

# 本地媒体扩展名（逗号分隔，含点）
LOCAL_IMAGE_EXTS=.jpg,.jpeg,.png,.webp,.gif
LOCAL_VIDEO_EXTS=.mp4,.webm,.mov,.mkv,.avi,.flv,.wmv,.m4v,.mpg,.mpeg

# ==================== 认证与日志 ====================

# Session 有效期（秒，默认 7 天）
SESSION_COOKIE_AGE=604800

# 日志级别与目录
DJANGO_LOG_LEVEL=INFO
# DJANGO_LOG_DIR=/app/JmWebProject/logs
